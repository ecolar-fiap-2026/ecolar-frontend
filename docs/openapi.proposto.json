  "components": {
    "schemas": {
      "ResidenciaInput": {
        "type": "object",
        "required": [
          "nome",
          "quantidadeMoradores",
          "tarifaKwh"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "quantidadeMoradores": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "tarifaKwh": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      },
      "ConsumoInput": {
        "type": "object",
        "required": [
          "data",
          "consumoKwh",
          "origem"
        ],
        "properties": {
          "data": {
            "type": "string",
            "format": "date"
          },
          "consumoKwh": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000
          },
          "origem": {
            "type": "string",
            "enum": [
              "MANUAL",
              "IMPORTADO",
              "SIMULADO"
            ]
          }
        }
      },
      "MetaInput": {
        "type": "object",
        "required": [
          "dataInicio",
          "dataFim",
          "limiteKwh"
        ],
        "properties": {
          "dataInicio": {
            "type": "string",
            "format": "date"
          },
          "dataFim": {
            "type": "string",
            "format": "date"
          },
          "limiteKwh": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000
          }
        }
      },
      "Previsao": {
        "type": "object",
        "required": [
          "dataAlvo",
          "consumoPrevistoKwh",
          "modelo"
        ],
        "properties": {
          "dataAlvo": {
            "type": "string",
            "format": "date"
          },
          "consumoPrevistoKwh": {
            "type": "number",
            "minimum": 0
          },
          "modelo": {
            "type": "string"
          }
        }
      },
      "Padrao": {
        "type": "object",
        "required": [
          "dataInicio",
          "dataFim",
          "grupo",
          "interpretacao",
          "modelo"
        ],
        "properties": {
          "dataInicio": {
            "type": "string",
            "format": "date"
          },
          "dataFim": {
            "type": "string",
            "format": "date"
          },
          "grupo": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "interpretacao": {
            "type": "string"
          },
          "modelo": {
            "type": "string"
          }
        }
      },
      "Erro": {
        "type": "object",
        "required": [
          "status",
          "codigo",
          "mensagem",
          "campos"
        ],
        "properties": {
          "status": {
            "type": "integer"
          },
          "codigo": {
            "type": "string"
          },
          "mensagem": {
            "type": "string"
          },
          "campos": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "Residencia": {
        "type": "object",
        "required": [
          "id",
          "nome",
          "quantidadeMoradores",
          "tarifaKwh"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "nome": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "quantidadeMoradores": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "tarifaKwh": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
